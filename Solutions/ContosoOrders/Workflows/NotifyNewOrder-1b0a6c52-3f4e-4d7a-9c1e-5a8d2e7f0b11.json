{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline": {
        "api": { "name": "shared_sharepointonline" },
        "connection": { "connectionReferenceLogicalName": "contoso_sharedsharepointonline" },
        "runtimeSource": "embedded"
      },
      "shared_office365": {
        "api": { "name": "shared_office365" },
        "connection": { "connectionReferenceLogicalName": "contoso_sharedoffice365" },
        "runtimeSource": "embedded"
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": { "defaultValue": {}, "type": "SecureObject" },
        "$connections": { "defaultValue": {}, "type": "Object" },
        "SharePoint Site (contoso_SharePointSite)": {
          "defaultValue": "https://contoso.sharepoint.com/sites/Sales",
          "type": "String",
          "metadata": { "schemaName": "contoso_SharePointSite" }
        },
        "SharePoint List (contoso_SharePointList)": {
          "defaultValue": "Orders",
          "type": "String",
          "metadata": { "schemaName": "contoso_SharePointList" }
        }
      },
      "triggers": {
        "When_an_item_is_created": {
          "type": "OpenApiConnection",
          "recurrence": { "frequency": "Minute", "interval": 5 },
          "inputs": {
            "parameters": {
              "dataset": "@parameters('SharePoint Site (contoso_SharePointSite)')",
              "table": "@parameters('SharePoint List (contoso_SharePointList)')"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "operationId": "GetOnNewItems",
              "connectionName": "shared_sharepointonline"
            }
          }
        }
      },
      "actions": {
        "Get_order_details": {
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "@parameters('SharePoint Site (contoso_SharePointSite)')",
              "table": "@parameters('SharePoint List (contoso_SharePointList)')",
              "id": "@triggerOutputs()?['body/ID']"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "operationId": "GetItem",
              "connectionName": "shared_sharepointonline"
            }
          },
          "runAfter": {},
          "runtimeConfiguration": { "secureData": { "properties": [ "inputs", "outputs" ] } }
        },
        "Build_order_notification": {
          "type": "Compose",
          "inputs": "@concat('New order: ', outputs('Get_order_details')?['body/Title'], ' (ID: ', string(outputs('Get_order_details')?['body/ID']), ')')",
          "runAfter": {
            "Get_order_details": ["Succeeded"]
          },
          "runtimeConfiguration": { "secureData": { "properties": [ "inputs", "outputs" ] } }
        },
        "Notify_sales_of_new_order": {
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "emailMessage/To": "sales@contoso.example",
              "emailMessage/Subject": "New order received",
              "emailMessage/Body": "@outputs('Build_order_notification')"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
              "operationId": "SendEmailV2",
              "connectionName": "shared_office365"
            }
          },
          "runAfter": {
            "Build_order_notification": ["Succeeded"]
          },
          "runtimeConfiguration": { "secureData": { "properties": [ "inputs", "outputs" ] } }
        }
      }
    }
  },
  "schemaVersion": "1.0.0.0"
}
